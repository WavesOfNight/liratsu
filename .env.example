# =============================================================================
#  Site Liratsu : variables d'environnement
#  Copier en `.env` puis compléter. NE JAMAIS committer le fichier .env.
#
#  Les clés des services (Twitch, Stripe, PayPal, Gelato, SMTP…) se saisissent de
#  préférence dans l'admin : Réglages > « Clés API & services » (stockées chiffrées).
#  Les variables ci-dessous ne servent que de REPLI si le champ admin est vide.
# =============================================================================

# --- Obligatoire -------------------------------------------------------------
# Connexion PostgreSQL
DATABASE_URL=postgres://liratsu:CHANGE_ME@127.0.0.1:5432/liratsu
# Secret Payload (sessions, signatures). Générer : openssl rand -hex 32
PAYLOAD_SECRET=
# Clé de chiffrement des secrets stockés en base. Générer : openssl rand -hex 32
# ⚠️ Ne plus la changer une fois des clés saisies dans l'admin (sinon il faudra les ressaisir).
ENCRYPTION_KEY=
# URL publique du site (sans / final) : sert aux redirections de paiement, CSRF, sitemap
NEXT_PUBLIC_SERVER_URL=https://liratsu.fr

# --- Optionnel ---------------------------------------------------------------
# Désactive le "push" automatique du schéma en dev (true par défaut hors production)
# PAYLOAD_DB_PUSH=false

# --- Replis facultatifs (préférer l'admin) -----------------------------------
# Twitch : https://dev.twitch.tv/console/apps
TWITCH_CHANNEL_LOGIN=liratsu
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# YouTube : ID de chaîne (UC…) pour le flux RSS public
YOUTUBE_CHANNEL_ID=

# Stripe : https://dashboard.stripe.com/apikeys
STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# PayPal : https://developer.paypal.com/dashboard/applications
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=

# Gelato : https://dashboard.gelato.com/keys
GELATO_API_KEY=
GELATO_WEBHOOK_TOKEN=

# SMTP (emails transactionnels)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Liratsu <boutique@liratsu.fr>"
ADMIN_NOTIFY_EMAIL=
